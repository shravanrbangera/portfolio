{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/creative", "destination": "/work.html" },
    { "source": "/milestones", "destination": "/achievements.html" },
    { "source": "/credentials", "destination": "/certifications.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
