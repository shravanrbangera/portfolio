{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/story", "destination": "/journey.html" },
    { "source": "/work", "destination": "/journey.html" },
    { "source": "/creative", "destination": "/journey.html" },
    { "source": "/achievements", "destination": "/journey.html" },
    { "source": "/milestones", "destination": "/journey.html" },
    { "source": "/certifications", "destination": "/about.html" },
    { "source": "/credentials", "destination": "/about.html" },
    { "source": "/contact", "destination": "/about.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
